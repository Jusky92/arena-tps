; Fichier de configuration du projet Godot 4.

config_version=5

[application]

config/name="Arena TPS"
run/main_scene="res://scenes/auth.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Inputs="*res://scripts/inputs.gd"
GameState="*res://scripts/game_state.gd"
Backend="*res://scripts/backend/backend.gd"
Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/Rajdhani-Medium.ttf"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
