[gd_scene format=3]

[node name="ScoreboardRow" type="PanelContainer"]
mouse_filter = 2

[node name="Cells" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Rank" type="Label" parent="Cells"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.5
theme_override_font_sizes/font_size = 18
text = "#"

[node name="PlayerName" type="Label" parent="Cells"]
unique_name_in_owner = true
