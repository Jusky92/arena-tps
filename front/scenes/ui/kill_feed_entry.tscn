[gd_scene format=3]

[node name="KillFeedEntry" type="PanelContainer"]
size_flags_horizontal = 8
mouse_filter = 2
theme_type_variation = &"FeedEntry"

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Killer" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudLabel"
theme_override_font_sizes/font_size = 17
text = "Tueur"

[node name="WeaponIcon" type="TextureRect" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 22)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="WeaponText" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 15
text = "[arme]"

[node name="Victim" type="Label" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudLabel"
theme_override_font_sizes/font_size = 17
text = "Victime"
